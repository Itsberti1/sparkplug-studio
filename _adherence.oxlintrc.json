{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/broadcast/**",
              "components/cards/**",
              "components/glass/**",
              "components/icons/**",
              "ui_kits/pitch-deck-saved-2026-09-25/**",
              "ui_kits/pitch-deck-saved-2026-09-29/**",
              "ui_kits/pitch-deck/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommentRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|message|avatarSrc|style|key|ref|className|style|children)$/]",
        "message": "<CommentRow> doesn't accept that prop. Declared props: name, message, avatarSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPrompt'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|side|tilt|style|key|ref|className|style|children)$/]",
        "message": "<GlassPrompt> doesn't accept that prop. Declared props: text, side, tilt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPrompt'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<GlassPrompt> side must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icons'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|state|dark|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icons> doesn't accept that prop. Declared props: name, state, dark, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icons'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|selected|unselected)$/]",
        "message": "<Icons> state must be one of 'default' | 'selected' | 'unselected'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LiveBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|style|key|ref|className|style|children)$/]",
        "message": "<LiveBadge> doesn't accept that prop. Declared props: label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|width|height|style|key|ref|className|style|children)$/]",
        "message": "<PanelCard> doesn't accept that prop. Declared props: title, children, width, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:imageSrc|caption|bold|style|key|ref|className|style|children)$/]",
        "message": "<StepCard> doesn't accept that prop. Declared props: imageSrc, caption, bold, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StreamerHandle'] > JSXAttribute > JSXIdentifier[name!=/^(?:handle|avatarSrc|verified|style|key|ref|className|style|children)$/]",
        "message": "<StreamerHandle> doesn't accept that prop. Declared props: handle, avatarSrc, verified, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ViewerCount'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|style|key|ref|className|style|children)$/]",
        "message": "<ViewerCount> doesn't accept that prop. Declared props: count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WilliamsLogo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|width|style|key|ref|className|style|children)$/]",
        "message": "<WilliamsLogo> doesn't accept that prop. Declared props: src, width, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "CommentRow": {
        "replaces": []
      },
      "GlassPrompt": {
        "replaces": []
      },
      "Icon": {
